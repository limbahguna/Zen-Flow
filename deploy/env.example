# Template for the VPS runtime environment file.
#
# On the VPS:
#   cp deploy/env.example .env
#   chmod 600 .env
#   # fill in real values with an editor, then never commit this file
#
# .env is git-ignored and excluded from the Docker build context, so nothing
# here is baked into the image. docker compose reads it at container start.
#
# Leave every value blank in this template. Do not commit real values.

# ── Build-time (Vite inlines these into the public browser bundle) ────────────
# Only put public Supabase values here. Never the service-role key.
# VITE_SUPABASE_URL must be exactly the Dashboard Project URL:
#   https://mdawcxxihzkaxozxznyx.supabase.co
# Same hostname Android uses. Never getmindfulspace.com and never a different ref.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# VITE_API_BASE_URL is intentionally omitted: the browser calls /api on the
# same origin. Setting it would break same-origin deployment.

# ── Runtime: server ───────────────────────────────────────────────────────────
NODE_ENV=production
# Compose project name isolates this stack from hermes-agent-lupk / openclaw-oyz2.
COMPOSE_PROJECT_NAME=mindful-space
# PORT inside the container is 3000 (set by docker-compose.yml). HOST_PORT is the
# loopback publish port for SSH-tunnel staging. Do not set HOST_PORT to 80 or 443;
# those host ports belong to the Caddy overlay (docker-compose.caddy.yml).
# Default 3010 avoids a clash with other local listeners on 3000.
HOST_PORT=3010

# ── Runtime: database ─────────────────────────────────────────────────────────
DATABASE_URL=

# ── Runtime: Supabase ─────────────────────────────────────────────────────────
# Must match VITE_SUPABASE_URL hostname: mdawcxxihzkaxozxznyx.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Runtime: AI coach ─────────────────────────────────────────────────────────
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_MODEL=

# ── Runtime: sessions and logging ─────────────────────────────────────────────
SESSION_SECRET=
LOG_LEVEL=info

# ── Runtime: CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of full origins (scheme + host + port if not default).
# The API splits on commas, trims whitespace, and ignores empty entries.
# Exact string match — no trailing slash (https://getmindfulspace.com not
# https://getmindfulspace.com/).
#
# Already allowed in code (no env entry required):
#   capacitor://localhost
#   http://localhost
#   https://localhost
#   https://getmindfulspace.com
#   https://www.getmindfulspace.com
#
# Staging SSH tunnel is NOT in that static list. Include it here so a browser
# at http://127.0.0.1:3010 can call the API. You may also repeat the public
# origins; extras merge with the static list.
#
# Staging only:
#   CORS_ALLOWED_ORIGINS=http://127.0.0.1:3010
# Staging plus explicit public origins (same format, no spaces required):
#   CORS_ALLOWED_ORIGINS=https://getmindfulspace.com,https://www.getmindfulspace.com,http://127.0.0.1:3010
CORS_ALLOWED_ORIGINS=

# ── Caddy overlay (docker-compose.caddy.yml) ──────────────────────────────────
# Required when starting Caddy. Use a mailbox you can read for Let's Encrypt
# expiry and account notices. Leave blank in this template; set it in .env
# before `docker compose -f docker-compose.yml -f docker-compose.caddy.yml up`.
# Do not put a real address in this example file.
CADDY_ACME_EMAIL=

# ── Unused Traefik overlay (docker-compose.traefik.yml) ───────────────────────
# Not used on this VPS. Public HTTPS is Caddy. Leave these unset.
# TRAEFIK_NETWORK=
# TRAEFIK_HOST=
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=
