# Template for the VPS runtime environment file.
#
# On the VPS:
#   cp deploy/env.example .env
#   chmod 600 .env
#   # fill in real values with an editor, then never commit this file
#
# .env is git-ignored and excluded from the Docker build context, so nothing
# here is baked into the image. docker compose reads it at container start.
#
# Leave every value blank in this template. Do not commit real values.

# ── Build-time (Vite inlines these into the public browser bundle) ────────────
# Only put public Supabase values here. Never the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# VITE_API_BASE_URL is intentionally omitted: the browser calls /api on the
# same origin. Setting it would break same-origin deployment.

# ── Runtime: server ───────────────────────────────────────────────────────────
NODE_ENV=production
# PORT is set to 3000 by docker-compose.yml. Change HOST_PORT, not PORT, to
# publish the container on a different loopback port.
HOST_PORT=3000

# ── Runtime: database ─────────────────────────────────────────────────────────
DATABASE_URL=

# ── Runtime: Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Runtime: AI coach ─────────────────────────────────────────────────────────
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_MODEL=

# ── Runtime: sessions and logging ─────────────────────────────────────────────
SESSION_SECRET=
LOG_LEVEL=info

# ── Runtime: CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of full origins. Entries are trimmed; empties ignored.
# Same-origin browser traffic needs no entry here. capacitor://localhost and the
# canonical getmindfulspace.com origins are already allowed in code.
# Example shape: https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=
